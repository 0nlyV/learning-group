{
  "private": true,
  "name": "learning-group",
  "version": "1.1.3",
  "license": "BSD-3-Clause",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "vite build",
    "deploy": "pnpm verify && devvit upload",
    "dev": "devvit playtest",
    "launch": "pnpm verify && devvit publish --public",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "format:check": "prettier --check .",
    "prettier": "prettier --write .",
    "test": "tsx --test tests/*.test.ts",
    "test:types": "tsc --build",
    "verify": "pnpm test && pnpm test:types && pnpm lint && pnpm format:check && pnpm build"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@devvit/start": "0.14.3",
    "@devvit/web": "0.14.3",
    "@hono/node-server": "2.1.1",
    "devvit": "0.14.3",
    "hono": "4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2"
  }
}
