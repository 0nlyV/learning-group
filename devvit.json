{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "learning-group",
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "journey": {
        "entry": "game.html"
      },
      "hub": {
        "inline": true,
        "entry": "hub.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_POST"]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Open Learning Group Portal",
        "description": "Find, create, copy, and manage community learning journeys",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/hub-open"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
